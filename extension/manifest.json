{
  "manifest_version": 3,
  "name": "刷词 · 划词收录",
  "version": "1.0.0",
  "description": "网页上划中一个英文单词，右键收进本地刷词词库，并带上读到它的那句话。",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "刷词 · 划词收录",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
